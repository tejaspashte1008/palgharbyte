# PalgharBites environment variables — copy to .env and fill in real values
# Never commit your real .env to git

# Server port
PORT=3000

# Session / JWT secret (use a long random string in production)
SESSION_SECRET=change_me_to_a_long_random_string

# SQLite database path (deployment-safe; no machine-specific paths)
# Leave as default (./data/palgharbites.db) or point to a managed disk path
DB_PATH=./data/palgharbites.db

# Razorpay keys (get from https://dashboard.razorpay.com → API Keys)
# If left empty, the app uses a built-in DEVELOPMENT payment simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PORT=3000

SESSION_SECRET=change_this_to_a_long_random_secret

DB_PATH=./data/palgharbites.db

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =========================
# EMAIL / SMTP
# =========================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your_16_character_app_password

SMTP_FROM=PalgharBites <yourgmail@gmail.com>

# Local
APP_URL=http://localhost:3000